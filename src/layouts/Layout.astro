---
import Sidebar from "@/components/layout/Sidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { HeadProps } from "@/types";

type Props = HeadProps;

const head = Astro.props;
---

<BaseLayout {...head}>
  <div
    class="site-container relative flex h-auto w-full max-w-[1440px] flex-col overflow-hidden rounded-none border border-border bg-card shadow-main md:w-[78vw] md:flex-row md:rounded-[2.5rem] transition-all duration-300"
  >
    <Sidebar />

    <main
      class="custom-scrollbar min-w-0 flex-1 overflow-x-hidden overflow-y-auto p-4 sm:p-6 md:p-8 lg:p-10 md:h-[min(880px,calc(100dvh-3rem))] transition-all duration-300"
    >
      <slot />
    </main>
  </div>
</BaseLayout>
