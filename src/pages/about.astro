---
import site from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";

const about = await getEntry("pages", "about");
const { Content } = await render(about!);

const toolkit = [
  { title: "产品探索", icon: "mdi:compass-outline", skills: ["用户访谈", "需求分析", "产品规划", "Figma 原型"] },
  { title: "AI 应用", icon: "mdi:robot-outline", skills: ["Prompt 设计与评测", "RAG", "Agent / Skills", "多模态场景拆解"] },
  { title: "数据与实现", icon: "mdi:code-braces", skills: ["Python", "SQL", "React", "Vibe Coding"] },
];
---

<Layout title={site.labels.aboutTitle} description={site.labels.aboutDescription}>
  <div class="animate-in fade-in mx-auto max-w-3xl p-4 sm:p-6 md:p-12 lg:p-16">
    <div class="prose dark:prose-invert mb-12 max-w-none">
      <Content />
    </div>

    <section class="mb-14">
      <div class="mb-6">
        <p class="mb-2 text-[10px] font-bold tracking-[0.28em] text-primary uppercase">TOOLKIT</p>
        <h2 class="text-2xl font-bold tracking-tight">我常用的工具与方法</h2>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {toolkit.map((group) => (
          <div class="rounded-2xl border border-border/60 bg-muted/20 p-5">
            <div class="mb-4 flex items-center gap-2 text-primary">
              <Icon name={group.icon} class="h-5 w-5" />
              <h3 class="text-sm font-bold text-foreground">{group.title}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => <span class="rounded-full bg-card px-2.5 py-1 text-[11px] text-muted-foreground">{skill}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-3xl border border-primary/15 bg-gradient-to-br from-primary/10 via-card to-muted/40 p-6 sm:p-8">
      <p class="mb-2 text-[10px] font-bold tracking-[0.28em] text-primary uppercase">SAY HELLO</p>
      <h2 class="text-2xl font-bold tracking-tight">聊一个具体的问题。</h2>
      <p class="mt-3 max-w-xl text-sm leading-7 text-muted-foreground">AI 产品、Agent 工作流、多模态应用，或者一个还没想清楚怎么解决的用户问题——都欢迎交流。</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {site.social.map((item) => (
          <a href={item.href} class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground/75 transition-colors hover:border-primary/40 hover:text-primary">
            <Icon name={item.icon} class="h-4 w-4" />{item.name}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
