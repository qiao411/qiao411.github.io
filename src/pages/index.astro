---
import Hero from "@/components/blocks/Hero.astro";
import AboutContent from "@/components/blocks/AboutContent.astro";
import RecentPosts from "@/components/blocks/RecentPosts.astro";
import site from "@/config/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout title={site.meta.title} description={site.meta.description}>
  <div
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-3xl px-1 py-6 sm:px-3 sm:py-8 md:px-4 md:py-10 lg:px-6"
  >
    <Hero />

    {site.features.homepageBlog && <RecentPosts />}

    <!-- <AboutContent /> -->
  </div>
</Layout>
