---
import Layout from "@/layouts/Layout.astro";
import site from "@/config/site";
import { Icon } from "astro-icon/components";

const deadlinerData = {
  stats: {
    totalUsers: "5000+",
    activeUsers: "100+",
    retention: "92%",
    dailyActive: "4 端",
  },
  features: [
    { icon: "mdi:message-processing-outline", title: "对话式任务管理", description: "以自然语言创建和管理任务，降低操作成本" },
    { icon: "mdi:format-list-checks", title: "智能任务拆解", description: "将复杂目标拆分为可执行的任务步骤" },
    { icon: "mdi:brain", title: "用户记忆学习", description: "探索 Agent 对用户偏好与习惯的持续学习" },
    { icon: "mdi:bell-ring", title: "智能提醒", description: "可自定义的提醒时间和频率" },
    { icon: "mdi:sync", title: "多端实时同步", description: "覆盖 Android、HarmonyOS、iOS 与 PC" },
    { icon: "mdi:account-voice", title: "用户反馈闭环", description: "通过访谈、社群与行为数据验证需求" },
  ],
};

const charts = [
  {
    id: "platform",
    title: "多端覆盖",
    description: "Android、HarmonyOS、iOS 与 PC",
    icon: "mdi:cellphone",
    placeholder: "Android / HarmonyOS / iOS / PC 端用户分布待补充",
  },
  {
    id: "activity",
    title: "AI 功能使用",
    description: "全应用 AI 使用率超过 80%",
    icon: "mdi:chart-timeline-variant",
    placeholder: "全应用 AI 使用率超过 80% · 趋势图待补充",
  },
  {
    id: "completion",
    title: "冷启动增长",
    description: "800+ 有效下载，400+ 注册用户",
    icon: "mdi:check-circle",
    placeholder: "800+ 有效下载 · 400+ 注册用户",
  },
  {
    id: "retention",
    title: "次月留存",
    description: "通过需求验证与产品迭代提升留存",
    icon: "mdi:account-group",
    placeholder: "次月留存率 92% · 留存曲线待补充",
  },
];
---

<Layout title="Deadliner - 项目详情" description="Deadliner 多端 AI Native 任务管理产品">
  <div class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-4xl p-4 sm:p-6 md:p-12 duration-700">
    <header class="mb-12">
      <a href="/projects" class="mb-6 inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors">
        <Icon name="mdi:arrow-left" class="h-4 w-4" />
        返回项目列表
      </a>
      <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-6">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-primary/15 text-primary shadow-lg sm:h-20 sm:w-20 overflow-hidden">
          <img
            src="/Deadliner Logo.jpg"
            alt="Deadliner logo"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="flex-1">
          <div class="mb-2 flex flex-wrap items-center gap-2 sm:gap-3">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">Deadliner</h1>
            <span class="rounded-full border border-primary/20 bg-primary/10 px-2 sm:px-3 py-0.5 sm:py-1 text-[10px] sm:text-xs font-bold tracking-widest text-primary uppercase">
              进行中
            </span>
          </div>
          <p class="text-sm sm:text-base text-muted-foreground">覆盖 Android、HarmonyOS、iOS 与 PC 的 AI Native 任务管理产品</p>
        </div>
      </div>
    </header>

    <section class="mb-12">
      <h2 class="mb-6 text-xl font-bold tracking-tight flex items-center gap-2">
        <Icon name="mdi:chart-line" class="h-5 w-5 text-primary" />
        核心数据
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-border/50 bg-muted/20 p-5 text-center transition-all duration-300 hover:border-primary/30 hover:bg-muted/30 hover:-translate-y-1">
          <div class="text-3xl font-bold text-primary mb-1">{deadlinerData.stats.totalUsers}</div>
          <div class="text-xs text-muted-foreground uppercase tracking-wider">累计用户</div>
        </div>
        <div class="rounded-xl border border-border/50 bg-muted/20 p-5 text-center transition-all duration-300 hover:border-primary/30 hover:bg-muted/30 hover:-translate-y-1">
          <div class="text-3xl font-bold text-primary mb-1">{deadlinerData.stats.activeUsers}</div>
          <div class="text-xs text-muted-foreground uppercase tracking-wider">核心测试群</div>
        </div>
        <div class="rounded-xl border border-border/50 bg-muted/20 p-5 text-center transition-all duration-300 hover:border-primary/30 hover:bg-muted/30 hover:-translate-y-1">
          <div class="text-3xl font-bold text-primary mb-1">{deadlinerData.stats.retention}</div>
          <div class="text-xs text-muted-foreground uppercase tracking-wider">次月留存率</div>
        </div>
        <div class="rounded-xl border border-border/50 bg-muted/20 p-5 text-center transition-all duration-300 hover:border-primary/30 hover:bg-muted/30 hover:-translate-y-1">
          <div class="text-3xl font-bold text-primary mb-1">{deadlinerData.stats.dailyActive}</div>
          <div class="text-xs text-muted-foreground uppercase tracking-wider">覆盖平台</div>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-xl font-bold tracking-tight flex items-center gap-2">
        <Icon name="mdi:chart-bar" class="h-5 w-5 text-primary" />
        数据图表
      </h2>
      <div class="rounded-2xl border border-border/50 bg-card p-6">
        <div class="relative overflow-hidden">
          <div class="charts-carousel flex transition-transform duration-500 ease-out" id="chartsCarousel">
            {charts.map((chart) => (
              <div class="chart-slide w-full flex-shrink-0" data-chart={chart.id}>
                <div class="flex flex-col items-center justify-center py-12 px-4">
                  <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                    <Icon name={chart.icon} class="h-8 w-8" />
                  </div>
                  <h3 class="mb-2 text-lg font-bold">{chart.title}</h3>
                  <p class="mb-8 text-sm text-muted-foreground text-center">{chart.description}</p>
                  <div class="flex h-48 w-full max-w-md items-center justify-center rounded-xl border-2 border-dashed border-border bg-muted/20">
                    <div class="text-center">
                      <Icon name="mdi:image-off" class="h-12 w-12 text-muted-foreground/50 mx-auto mb-3" />
                      <p class="text-sm text-muted-foreground">{chart.placeholder}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <button
            id="prevChart"
            class="absolute left-1 sm:left-2 top-1/2 -translate-y-1/2 flex h-8 w-8 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-card border border-border/50 shadow-sm hover:bg-muted/50 transition-colors"
            aria-label="上一页"
          >
            <Icon name="mdi:chevron-left" class="h-4 w-4 sm:h-5 sm:w-5" />
          </button>
          <button
            id="nextChart"
            class="absolute right-1 sm:right-2 top-1/2 -translate-y-1/2 flex h-8 w-8 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-card border border-border/50 shadow-sm hover:bg-muted/50 transition-colors"
            aria-label="下一页"
          >
            <Icon name="mdi:chevron-right" class="h-4 w-4 sm:h-5 sm:w-5" />
          </button>
        </div>

        <div class="mt-6 flex items-center justify-center gap-2">
          {charts.map((chart, index) => (
            <button
              class="chart-indicator h-2 rounded-full transition-all duration-300"
              data-index={index}
              aria-label={`跳转到 ${chart.title}`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-xl font-bold tracking-tight flex items-center gap-2">
        <Icon name="mdi:star" class="h-5 w-5 text-primary" />
        核心功能
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-3 gap-4">
        {deadlinerData.features.map((feature) => (
          <div class="rounded-xl border border-border/50 bg-muted/20 p-5 transition-all duration-300 hover:border-primary/30 hover:bg-muted/30 hover:-translate-y-1">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/15 text-primary">
              <Icon name={feature.icon} class="h-5 w-5" />
            </div>
            <h3 class="mb-1 text-sm font-bold">{feature.title}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-xl font-bold tracking-tight flex items-center gap-2">
        <Icon name="mdi:code-tags" class="h-5 w-5 text-primary" />
        技术栈
      </h2>
      <div class="flex flex-wrap gap-3">
        {["Android", "HarmonyOS", "iOS", "PC", "AI Agent", "Prompt Engineering"].map((tech) => (
          <span class="rounded-lg border border-border/50 bg-muted/20 px-4 py-2 font-mono text-sm text-primary/70 hover:border-primary/30 hover:bg-muted/30 transition-all">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <section class="mb-8">
      <h2 class="mb-6 text-xl font-bold tracking-tight flex items-center gap-2">
        <Icon name="mdi:link" class="h-5 w-5 text-primary" />
        相关链接
      </h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://apps.apple.com/cn/app/deadliner%E5%BE%85%E5%8A%9E%E6%97%A5%E5%8E%86/id6760482719"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-border/50 bg-muted/20 px-6 py-3 font-medium hover:border-primary/40 hover:bg-muted/30 transition-all"
        >
          <Icon name="mdi:web" class="h-5 w-5" />
          iOS App Store
        </a>
        <a
          href="https://github.com/DeadlinerStudio"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-border/50 bg-muted/20 px-6 py-3 font-medium hover:border-primary/40 hover:bg-muted/30 transition-all"
        >
          <Icon name="mdi:github" class="h-5 w-5" />
          GitHub
        </a>
        <a
          href="https://github.com/DeadlinerStudio/Deadliner/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-border/50 bg-muted/20 px-6 py-3 font-medium hover:border-primary/40 hover:bg-muted/30 transition-all"
        >
          <Icon name="mdi:android" class="h-5 w-5" />
          Android 下载
        </a>
        <a
          href="https://appgallery.huawei.com/app/detail?id=com.aritxonly.deadliner&channelId=SHARE&source=appshare"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-border/50 bg-muted/20 px-6 py-3 font-medium hover:border-primary/40 hover:bg-muted/30 transition-all"
        >
          <Icon name="mdi:cellphone" class="h-5 w-5" />
          华为应用市场
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .chart-indicator {
    width: 8px;
    background-color: rgba(0, 0, 0, 0.2);
  }
  .chart-indicator.active {
    width: 24px;
    background-color: var(--primary);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('chartsCarousel');
    const prevBtn = document.getElementById('prevChart');
    const nextBtn = document.getElementById('nextChart');
    const indicators = document.querySelectorAll('.chart-indicator');
    let currentIndex = 0;
    const totalSlides = indicators.length;

    function updateCarousel(index: number) {
      if (!carousel) return;
      currentIndex = Math.max(0, Math.min(index, totalSlides - 1));
      carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
      indicators.forEach((indicator, i) => {
        indicator.classList.toggle('active', i === currentIndex);
      });
    }

    prevBtn?.addEventListener('click', () => updateCarousel(currentIndex - 1));
    nextBtn?.addEventListener('click', () => updateCarousel(currentIndex + 1));

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => updateCarousel(index));
    });

    updateCarousel(0);
  });
</script>
