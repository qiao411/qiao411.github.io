---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getCollection } from "astro:content";
import site from "@/config/site";

const projects = await getCollection("projects");
const featured = projects.find((project) => project.data.title.includes("Deadliner"));
const otherProjects = projects.filter((project) => project.id !== featured?.id);
---

<Layout title={site.labels.projectsTitle} description={site.labels.projectsDescription}>
  <div class="projects-page animate-in mx-auto w-full px-1 py-6 sm:px-3 sm:py-8 md:px-4 md:py-10 lg:px-6">
    <header class="mb-8 border-b border-border/70 pb-7 sm:mb-10 sm:pb-8">
      <div class="mb-5 flex items-center gap-2.5 text-[10px] font-medium tracking-[0.2em] text-primary/80 uppercase" aria-hidden="true">
        <span class="h-px w-6 bg-primary/50"></span>
        Selected work
      </div>
      <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 class="mb-0 text-3xl font-bold tracking-tight sm:text-4xl">{site.labels.projectsTitle}</h2>
        <span class="shrink-0 text-xs text-muted-foreground/60">{projects.length} 个项目</span>
      </div>
      <p class="mb-0 text-sm leading-7 text-muted-foreground/80">{site.labels.projectsDescription}</p>
    </header>

    {featured && <ProjectCard project={featured} featured />}

    {otherProjects.length > 0 && (
      <section class:list={[{ "mt-9 sm:mt-10": featured }]} aria-labelledby="other-projects">
        <div class="mb-5 flex items-center gap-3">
          <h3 id="other-projects" class="mb-0 text-sm font-medium text-muted-foreground">更多探索</h3>
          <span class="h-px flex-1 bg-border/70" aria-hidden="true"></span>
          <span class="font-mono text-[10px] text-muted-foreground/50" aria-hidden="true">{String(otherProjects.length).padStart(2, "0")}</span>
        </div>
        <div class="exploration-grid grid gap-4">
          {otherProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .projects-page {
    container: projects / inline-size;
  }

  @container projects (min-width: 780px) {
    .exploration-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
