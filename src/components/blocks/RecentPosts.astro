---
import { getEntry } from "astro:content";
import { formatDate } from "@/utils/date";
import { getRecentPosts } from "@/utils/post";
import { Icon } from "astro-icon/components";

const recentPosts = await getRecentPosts(3);
const notes = await Promise.all(
  recentPosts.map(async (post) => ({
    post,
    category: await getEntry(post.data.category),
  })),
);
---

<section id="field-notes" class="scroll-mt-8 border-t border-border/60 pt-10 sm:pt-14">
  <div class="mb-7 flex flex-col gap-4 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 text-[10px] font-bold tracking-[0.3em] text-primary uppercase">FIELD NOTES · AI & AGENT</p>
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">最近在想的事</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">一些来自产品现场的观察、试验和未完成的问题。</p>
    </div>
    <a href="/posts" class="inline-flex w-fit items-center gap-2 border-b border-border pb-1 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-primary">
      所有手记 <Icon name="mdi:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
    {notes.map(({ post, category }, index) => (
      <a href={`/posts/${post.id}`} class="group flex min-h-56 flex-col rounded-2xl border border-border/60 bg-muted/20 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-card hover:shadow-lg">
        <div class="mb-8 flex items-center justify-between">
          <span class="font-mono text-xs tracking-widest text-primary/70">NOTE / 0{index + 1}</span>
          <span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-semibold text-primary">{category?.data.name}</span>
        </div>
        <div class="flex-1">
          <p class="mb-2 font-mono text-[10px] text-muted-foreground/60">{formatDate(post.data.createdAt)}</p>
          <h3 class="text-lg font-bold leading-snug tracking-tight transition-colors group-hover:text-primary">{post.data.title}</h3>
          <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{post.data.summary}</p>
        </div>
        <span class="mt-5 flex items-center justify-between border-t border-border/50 pt-3 text-xs font-medium text-muted-foreground">
          打开这篇手记 <Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:text-primary" />
        </span>
      </a>
    ))}
  </div>
</section>
