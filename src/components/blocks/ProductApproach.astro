---
import { Icon } from "astro-icon/components";

const principles = [
  {
    number: "01",
    icon: "mdi:account-search-outline",
    title: "先找到人卡住的那一步",
    body: "从课堂实验、会议记录或待办清单里的真实动作开始，而不是先给模型找一个展示机会。",
    note: "USER MOMENT",
  },
  {
    number: "02",
    icon: "mdi:chart-box-outline",
    title: "把“好不好用”变成可判断",
    body: "把需求写成评测标准和可复现的测试集，再看准确性、安全性、完成率和用户反馈。",
    note: "EVALUATION",
  },
  {
    number: "03",
    icon: "mdi:rocket-launch-outline",
    title: "让原型走进真实流程",
    body: "原型不是终点。和研发一起处理边界、验收与上线，让一次聪明的回答变成稳定的产品能力。",
    note: "SHIP & LEARN",
  },
];
---

<section class="mb-14 sm:mb-20">
  <div class="mb-7 flex items-end justify-between gap-4">
    <div>
      <p class="mb-3 text-[10px] font-bold tracking-[0.3em] text-primary uppercase">HOW I BUILD</p>
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">我做 AI 产品时，会反复确认这三件事。</h2>
    </div>
    <a href="/experience" class="hidden shrink-0 items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-primary sm:inline-flex">
      看完整经历 <Icon name="mdi:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
    {principles.map((item) => (
      <article class="rounded-2xl border border-border/60 bg-card p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg sm:p-6">
        <div class="mb-8 flex items-center justify-between">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary"><Icon name={item.icon} class="h-5 w-5" /></span>
          <span class="font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50">{item.number} / {item.note}</span>
        </div>
        <h3 class="text-lg font-bold leading-snug">{item.title}</h3>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">{item.body}</p>
      </article>
    ))}
  </div>
  <a href="/experience" class="mt-5 inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-primary sm:hidden">
    看完整经历 <Icon name="mdi:arrow-up-right" class="h-4 w-4" />
  </a>
</section>
