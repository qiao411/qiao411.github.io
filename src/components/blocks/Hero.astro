---
import { Icon } from "astro-icon/components";
import site from "@/config/site";
---

<section class="mb-10 sm:mb-12 space-y-4 sm:space-y-5">
  <p class="text-[11px] font-bold tracking-[0.28em] text-primary uppercase">AI PRODUCT · AGENT · FIELD NOTES</p>
  <h2 class="max-w-2xl text-3xl sm:text-4xl md:text-5xl font-bold leading-tight tracking-tight">{site.hero.greeting}</h2>
  <p
    class="max-w-2xl text-base sm:text-lg leading-8 font-light text-muted-foreground"
    set:html={site.hero.description}
  />
  {site.hero.subdescription && (
    <p
      class="max-w-2xl text-sm sm:text-base leading-7 font-light text-muted-foreground"
    >{site.hero.subdescription}</p>
  )}
  <div class="flex flex-wrap gap-3 pt-2">
    <a href="/projects" class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-transform hover:-translate-y-0.5">
      看看我做的产品 <Icon name="mdi:arrow-right" class="h-4 w-4" />
    </a>
    <a href="#field-notes" class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium text-foreground/75 transition-colors hover:border-primary/40 hover:text-primary">
      读几篇 AI 手记 <Icon name="mdi:arrow-down" class="h-4 w-4" />
    </a>
  </div>
</section>

{
  site.hero.cards.length > 0 && (
    <div class="mb-12 sm:mb-16 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4">
      {site.hero.cards.map((card, i) => (
        <div
          class="group relative overflow-hidden rounded-2xl border border-border/50 bg-gradient-to-br from-card to-muted/40 p-5 transition-all duration-300 hover:border-primary/30 hover:-translate-y-1 shadow-sm hover:shadow-md animate-in fade-in slide-in-from-bottom-4"
          style={`animation-delay: ${i * 100}ms`}
        >
          <div class="mb-4 flex items-start justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
              <Icon name={card.icon} />
            </div>
            <span class="font-mono text-[10px] tracking-[0.2em] text-muted-foreground/50">0{i + 1}</span>
          </div>
          <div class="flex flex-col">
            <span class="text-3xl font-bold tracking-tight text-foreground">{card.metric}</span>
            <span class="mt-1 text-xs font-bold tracking-widest text-primary uppercase">{card.label}</span>
            <span class="mt-3 text-sm leading-relaxed text-muted-foreground">{card.value}</span>
          </div>
        </div>
      ))}
    </div>
  )
}
