---
import { Icon } from "astro-icon/components";
import site from "@/config/site";
import intro from "@/content/miscs/home-intro.json";
---

<section class="mb-12 sm:mb-16" aria-label="首页介绍">
  <div class="space-y-4 sm:space-y-6">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">{site.hero.greeting}</h2>
    <p class="text-base sm:text-lg md:text-xl leading-relaxed font-light text-muted-foreground">
      {site.hero.description}
    </p>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 sm:mt-10">
    {intro.map((item) => (
      <section class="border-t border-border/60 pt-4">
        <h3 class="mb-2 flex items-center gap-2 text-sm font-semibold text-primary">
          <Icon name={item.icon} size={18} aria-hidden="true" />
          {item.title}
        </h3>
        {item.sentences.map((sentence) => (
          <p class="text-sm leading-relaxed text-muted-foreground">{sentence}</p>
        ))}
      </section>
    ))}
  </div>
</section>

{site.hero.cards.length > 0 && (
  <section class="mb-12 sm:mb-16" aria-label="近况与成果">
    <dl class="divide-y divide-border/50 border-y border-border/50">
      {site.hero.cards.map((item) => (
        <div class="grid grid-cols-1 gap-2 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
          <dt class="flex items-center gap-2 text-xs font-medium text-primary">
            <Icon name={item.icon} size={16} aria-hidden="true" />
            {item.label}
          </dt>
          <dd class="text-sm leading-relaxed text-foreground/90">{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
