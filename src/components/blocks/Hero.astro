---
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import site from "@/config/site";

const entries = (await getCollection("homeSections")).sort((a, b) => a.data.order - b.data.order);
const sections = await Promise.all(entries.map(async (entry) => ({
  entry,
  ...await render(entry),
})));
---

<section class="mb-12 sm:mb-16" aria-label="首页介绍">
  <div class="space-y-4 sm:space-y-6">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">{site.hero.greeting}</h2>
    <p class="text-base sm:text-lg md:text-xl leading-relaxed font-light text-muted-foreground">
      {site.hero.description}
    </p>
  </div>

  <div class="mt-10 space-y-8 sm:mt-12 sm:space-y-10">
    {sections.map(({ entry, Content }) => (
      <section aria-labelledby={`home-${entry.id}`}>
        <h3 id={`home-${entry.id}`} class="mb-3 flex items-center gap-2 text-lg font-semibold text-foreground">
          <Icon name={entry.data.icon} size={20} class="shrink-0 text-primary" aria-hidden="true" />
          {entry.data.title}
        </h3>
        <div class="prose prose-sm dark:prose-invert max-w-none leading-relaxed text-muted-foreground prose-p:my-3 prose-ul:my-3 prose-ol:my-3 prose-headings:text-foreground prose-a:text-primary">
          <Content />
        </div>
      </section>
    ))}
  </div>
</section>

{site.hero.cards.length > 0 && (
  <section class="mb-12 sm:mb-16" aria-label="近况与成果">
    <dl class="divide-y divide-border/50 border-y border-border/50">
      {site.hero.cards.map((item) => (
        <div class="grid grid-cols-1 gap-2 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
          <dt class="flex items-center gap-2 text-xs font-medium text-primary">
            <Icon name={item.icon} size={16} aria-hidden="true" />
            {item.label}
          </dt>
          <dd class="text-sm leading-relaxed text-foreground/90">{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
