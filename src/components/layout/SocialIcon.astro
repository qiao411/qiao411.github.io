---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;
---

<span class:list={["social-icon", className]} style={`width:${size}px;height:${size}px`} aria-hidden="true">
{name.startsWith("/") ? (
  <span
    class="block shrink-0 bg-current"
    style={`width:${size}px;height:${size}px;transform:scale(1.2);mask:url('${name}') center / contain no-repeat;-webkit-mask:url('${name}') center / contain no-repeat`}
    aria-hidden="true"
  />
) : (
  <Icon name={name} size={size} class="block shrink-0" />
)}

</span>

<style>
  .social-icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; vertical-align: middle; line-height: 0; }
</style>
