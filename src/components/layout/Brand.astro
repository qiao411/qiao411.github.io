---
import site from "@/config/site";
import { Image } from "astro:assets";
---

<div
  class="mb-6 flex items-start gap-4 md:mb-10 md:flex-col md:items-start md:gap-0"
>
  <div
    class="flex h-16 w-16 items-center justify-center rounded-full bg-muted text-lg font-bold text-primary-foreground md:h-18 md:w-18 overflow-hidden"
  >
    <Image
      loading={"eager"}
      src={site.meta.logo}
      alt={"Site logo"}
      width={80}
      height={80}
      class="rounded-full"
    />
  </div>
  <div class="mt-2 md:mt-8">
    <h1
      data-pagefind-ignore
      class="text-lg font-bold tracking-tight text-foreground md:text-xl"
    >
      {site.meta.title}
    </h1>
    <p
      class="mt-2 hidden text-xs text-muted-foreground/70 md:block"
    >
      {site.meta.description}
    </p>
  </div>
</div>
