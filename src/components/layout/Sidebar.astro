---
import site from "@/config/site";
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SocialIcon from "./SocialIcon.astro";
import Brand from "./Brand.astro";
import SearchModal from "../blocks/SearchModal.astro";
import SearchBox from "./SearchBox.astro";
---

<aside
  class="flex w-full flex-col border-b border-border bg-muted/20 p-4 sm:p-6 md:w-[30%] lg:w-[28%] md:border-r md:border-b-0 md:p-8 lg:p-10 transition-all duration-300"
  data-pagefind-ignore="all"
>
  <Brand />

  <SearchBox />

  <Nav />

  <div class="mt-auto flex items-center justify-between pt-8">
    <div class="flex gap-4 text-muted-foreground/60">
      {
        site.social.map((item) => (
          item.copyValue ? (
            <button
              type="button"
              data-copy-contact={item.copyValue}
              data-copy-message={item.copyMessage}
              class="cursor-pointer transition-all duration-200 hover:text-primary hover:scale-110"
              aria-label={`复制${item.name}：${item.copyValue}`}
              title={`点击复制${item.name}`}
            >
              <SocialIcon name={item.icon} size={24} />
            </button>
          ) : (
            <a
              href={item.href}
              class="cursor-pointer transition-all duration-200 hover:text-primary hover:scale-110"
              aria-label={item.name}
              title={item.name}
            >
              <SocialIcon name={item.icon} size={24} />
            </a>
          )
        ))
      }
    </div>

    <ThemeToggle />
  </div>

  <SearchModal />
</aside>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-contact]");
    const value = button?.dataset.copyContact;
    if (!button || !value) return;

    try {
      await navigator.clipboard.writeText(value);
    } catch {
      try {
        const field = document.createElement("textarea");
        field.value = value;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.append(field);
        field.select();
        document.execCommand("copy");
        field.remove();
      } catch {
        // Still show the requested feedback if browser clipboard access is unavailable.
      }
    }

    let toast = document.getElementById("contact-copy-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "contact-copy-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");
      toast.className = "fixed bottom-6 left-1/2 z-[100] -translate-x-1/2 rounded-xl bg-foreground px-4 py-2 text-sm text-background shadow-lg pointer-events-none";
      toast.style.opacity = "0";
      toast.style.transition = "opacity 200ms ease";
      document.body.append(toast);
    }
    toast.textContent = button.dataset.copyMessage || "已复制";
    toast.style.opacity = "1";
    window.clearTimeout(Number(toast.dataset.hideTimer));
    toast.dataset.hideTimer = String(window.setTimeout(() => {
      if (toast) toast.style.opacity = "0";
    }, 1800));
  });
</script>
