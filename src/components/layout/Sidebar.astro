---
import site from "@/config/site";
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SocialIcon from "./SocialIcon.astro";
import Brand from "./Brand.astro";
import SearchModal from "../blocks/SearchModal.astro";
import SearchBox from "./SearchBox.astro";
---

<aside
  class="flex w-full flex-col border-b border-border bg-muted/20 p-4 sm:p-6 md:w-[30%] lg:w-[28%] md:border-r md:border-b-0 md:p-8 lg:p-10 transition-all duration-300"
  data-pagefind-ignore="all"
>
  <Brand />

  <SearchBox />

  <Nav />

  <div class="mt-auto flex items-center justify-between pt-8">
    <div class="flex gap-4 text-muted-foreground/60">
      {
        site.social.map((item) => (
          item.value ? (
            <button
              type="button"
              data-copy-contact={item.value}
              class="cursor-pointer transition-all duration-200 hover:text-primary hover:scale-110"
              aria-label={`复制微信号：${item.value}`}
              title={`微信号：${item.value}（点击复制）`}
            >
              <SocialIcon name={item.icon} size={24} />
            </button>
          ) : (
            <a
              href={item.href}
              class="cursor-pointer transition-all duration-200 hover:text-primary hover:scale-110"
              aria-label={item.name}
              title={item.name}
            >
              <SocialIcon name={item.icon} size={24} />
            </a>
          )
        ))
      }
    </div>

    <ThemeToggle />
  </div>

  <SearchModal />
</aside>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-contact]");
    const value = button?.dataset.copyContact;
    if (!button || !value) return;

    try {
      await navigator.clipboard.writeText(value);
      button.title = `微信号已复制：${value}`;
      window.setTimeout(() => {
        button.title = `微信号：${value}（点击复制）`;
      }, 1600);
    } catch {
      button.title = `微信号：${value}`;
    }
  });
</script>
